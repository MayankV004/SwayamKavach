# SwayamKavach Environment Configuration Template
# Copy to .env and adapt for local development

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Database (PostgreSQL)
POSTGRES_USER=swayam_user
POSTGRES_PASSWORD=swayam_secret_password
POSTGRES_DB=swayamkavach
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://swayam_user:swayam_secret_password@localhost:5432/swayamkavach

# Model Serving Slots
SLOT_A_URL=http://localhost:8001
SLOT_B_URL=http://localhost:8002
ACTIVE_CHAMPION_SLOT=A
CURRENT_RELEASE_ID=R1

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=swayamkavach_ids

# Ingestion / Sensor Security
SENSOR_API_KEY=dev-sensor-key-secret-1234
MAX_BATCH_SIZE=1000

# DARI Policy Defaults
DARI_COOLDOWN_MINUTES=60
DARI_MIN_SAMPLES=500
DARI_DX_THRESHOLD=0.15
DARI_DB_THRESHOLD=0.60
